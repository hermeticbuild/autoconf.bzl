module(name = "autoconf_examples")

bazel_dep(name = "autoconf.bzl", version = "0.0.0")
local_path_override(
    module_name = "autoconf.bzl",
    path = "..",
)

bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "llvm", version = "0.8.24")

register_toolchains("@llvm//toolchain:all")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "libogg",
    build_file = "//libogg:upstream.BUILD.bazel",
    sha256 = "c4d91be36fc8e54deae7575241e03f4211eb102afb3fc0775fbbc1b740016705",
    strip_prefix = "libogg-1.3.5",
    urls = ["https://downloads.xiph.org/releases/ogg/libogg-1.3.5.tar.xz"],
)
