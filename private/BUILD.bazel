load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:private"])

bzl_library(
    name = "autoconf_bzl",
    srcs = ["autoconf.bzl"],
    visibility = ["//:__pkg__"],
    deps = [
        "@rules_cc//cc:action_names_bzl",
        "@rules_cc//cc:find_cc_toolchain_bzl",
        "@rules_cc//cc/common",
    ],
)

bzl_library(
    name = "payload_bzl",
    srcs = ["payload.bzl"],
    visibility = ["//:__pkg__"],
)

cc_library(
    name = "runtime",
    srcs = ["runtime.cc"],
    hdrs = ["runtime.h"],
    copts = ["-std=c++17"],
    # Internal support shared with the separate example and test modules.
    visibility = ["//visibility:public"],
)

cc_library(
    name = "runner_lib",
    srcs = ["runner_lib.cc"],
    copts = ["-std=c++17"],
    visibility = ["//visibility:public"],
    deps = [":runtime"],
)

cc_binary(
    name = "runner",
    srcs = ["runner.cc"],
    copts = ["-std=c++17"],
    deps = [":runner_lib"],
)

cc_binary(
    name = "executor",
    srcs = ["executor.cc"],
    copts = ["-std=c++17"],
    visibility = ["//visibility:public"],
    deps = [":runtime"],
)
